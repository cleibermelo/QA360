{
  "name": "QAPulse",
  "version": "1.10.1",
  "productName": "QAPulse",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "debug": "ng serve --configuration debugging",
    "build": "npm run lint && npm run build:licensing && ng build --configuration production",
    "build:licensing": "node -e \"if (require('fs').existsSync('kendo-ui-license.txt') || require('fs').existsSync('telerik-license.txt')){ require('child_process').execSync('npx kendo-ui-license activate', {stdio: 'inherit'}); } else { console.warn('No Kendo UI license detected. Build will continue without licensing.'); }\"",
    "build:dev": "ng build --source-map --configuration production",
    "build:debug": "ng build --configuration debugging",
    "test": "ng test",
    "test:dev": "ng test --configuration debugging",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "explore": "source-map-explorer dist/**/*.js",
    "install": "npm install --ignore-scripts && ng g @polygon/schematics:generated-code",
    "reinstall": "npm i -g rimraf && rimraf --glob node_modules .angular && npm cache clean --force && npm run install",
    "postinstall": "ng g @polygon/schematics:generated-code"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "v20-lts",
    "@angular/common": "v20-lts",
    "@angular/compiler": "v20-lts",
    "@angular/core": "v20-lts",
    "@angular/forms": "v20-lts",
    "@angular/localize": "v20-lts",
    "@angular/platform-browser": "v20-lts",
    "@angular/platform-browser-dynamic": "v20-lts",
    "@angular/router": "v20-lts",
    "@angular/service-worker": "v20-lts",
    "@polygon/components": "release-20.0.0",
    "@polygon/core": "release-20.0.0",
    "@polygon/dashboard": "release-20.0.0",
    "@polygon/forms": "release-20.0.0",
    "@polygon/qbuilder": "release-20.0.0",
    "@polygon/shell": "release-20.0.0",
    "@polygon/themes": "release-20.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular/build": "v20-lts",
    "@angular/cli": "v20-lts",
    "@angular/compiler-cli": "v20-lts",
    "@polygon/client-lib": "release-20.0.0",
    "@polygon/schematics": "release-20.0.0",
    "@types/jasmine": "5.1.13",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.3.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "5.5.4",
    "jasmine-core": "5.9.0",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "source-map-explorer": "2.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0"
  }
}
