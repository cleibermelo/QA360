{
  "$schema": "../../../../node_modules/@polygon/schematics/schemas/environment-json.schema.json",
  "name": "prod",
  "production": true,
  "productName": "QA360",
  "pushNotifications": {
    "endpoint": ""
  },
  "authentication": {
    "enabled": false,
    "mode": "jwt",
    "jwtOptions": {
      "endpoint": "https://st.id.cegid.cloud",
      "clientId": "client-app-PKCE",
      "scopes": "openid profile email",
      "returnUrl": "https://localhost:4200/",
      "postLogoutUrl": "https://localhost:4200/",
      "flowType": "pkce"
    }
  },
  "caching": {
    "version": "v1",
    "isolationKey": "QA360-DV"
  },
  "routingOptions": {
    "ignoreCaseRoutesEnabled": true
  },
  "telemetry": {
    "flushIntervalMs": 300000,
    "loggers": {
      "default": "Info",
      "enabled": true,
      "overrides": {
        "consoleLogger": {
          "enabled": true,
          "logLevel": "Trace"
        }
      }
    },
    "metrics": {
      "enabled": true,
      "overrides": {
        "ConsoleMetricProvider": {
          "enabled": true
        }
      }
    }
  },
  "version": "1.0.0"
}
