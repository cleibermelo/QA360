{
  "$schema": "../../../../node_modules/@polygon/schematics/schemas/environment-json.schema.json",
  "name": "prod",
  "production": true,
  "productName": "QAPulse",
  "pushNotifications": {
    "enabled": false,
    "endpoint": ""
  },
  "authentication": {
    "enabled": false,
    "mode": "jwt",
    "jwtOptions": {
      "endpoint": "https://st.id.cegid.cloud",
      "clientId": "client-app-PKCE",
      "scopes": "openid profile email",
      "returnUrl": "https://localhost:4200/",
      "postLogoutUrl": "https://localhost:4200/",
      "flowType": "pkce"
    }
  },
  "caching": {
    "version": "v1",
    "isolationKey": "QAPulse-SX"
  },
  "routingOptions": {
    "ignoreCaseRoutesEnabled": true
  },
  "telemetry": {
    "flushIntervalMs": 300000,
    "loggers": {
      "default": "Warn",
      "enabled": true
    },
    "metrics": {
      "enabled": true
    }
  },
  "supabase": {
    "url": "",
    "anonKey": "",
    "passwordMinLength": 6
  },
  "version": "1.9.0"
}
