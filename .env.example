# Copy to .env for local runs (never commit .env). The app itself reads assets/environment.json, not this file.

# SonarCloud: token used only by the sync job (scripts/sonar-sync).
SONAR_TOKEN=
SONAR_ORG=cegidgroup
# Term sent as "q" to filter the projects; leave empty to bring all of them.
SONAR_PROJECT_FILTER=iberia

# Supabase: the service role key can write (job only, never in the app); the anon key is the public one.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
